{
  "benchmark_name": "Rousseau_RAG_vs_GraphRAG_Benchmark",
  "version": "1.0",
  "description": "A domain-specific benchmark for comparing conventional vector RAG and GraphRAG over a multi-document corpus of Jean-Jacques Rousseau's writings.",
  "design": {
    "total_questions": 60,
    "categories": {
      "local_fact_retrieval": 20,
      "cross_document_reasoning": 20,
      "global_sensemaking": 20
    },
    "evaluation_note": "Both systems should answer the exact same questions using the same source corpus and, where possible, the same generation model and comparable context limits.",
    "recommended_metrics": [
      "comprehensiveness",
      "diversity",
      "empowerment",
      "directness",
      "faithfulness",
      "latency",
      "token_usage",
      "estimated_cost"
    ]
  },
